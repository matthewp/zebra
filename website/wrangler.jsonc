{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zebra-website",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "zebra.libs.technology", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
